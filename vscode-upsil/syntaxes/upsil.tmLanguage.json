{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "UpsiL",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.upsil",
          "match": "\\b(if|else|for|while|return|class|fun|val|var|model|gpu_kernel|tensor|prob|import|vector_store|llm)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.upsil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.upsil",
          "match": "\\\\."
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.upsil",
          "match": "//.*$"
        }
      ]
    }
  },
  "scopeName": "source.upsil"
}
