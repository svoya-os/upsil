{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Generated by tools/gen_syntax.py from upsil/keywords.py; do not edit by hand.",
  "name": "UpsiL",
  "scopeName": "source.upsil",
  "fileTypes": [
    "upl"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#prompt"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#calls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.upsil",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.upsil",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.upsil",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.upsil",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.upsil",
      "match": "\\\\(?:[ntr0\"'\\\\{}]|u[0-9a-fA-F]{4}|u\\{[0-9a-fA-F]{1,6}\\})"
    },
    "interpolation": {
      "name": "meta.interpolation.upsil",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.upsil"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.upsil"
        }
      },
      "contentName": "meta.embedded.expression.upsil",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.upsil",
          "match": "\\b0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*\\b"
        },
        {
          "name": "constant.numeric.binary.upsil",
          "match": "\\b0[bB][01](?:_?[01])*\\b"
        },
        {
          "name": "constant.numeric.octal.upsil",
          "match": "\\b0[oO][0-7](?:_?[0-7])*\\b"
        },
        {
          "name": "constant.numeric.decimal.upsil",
          "match": "\\b[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fun|graph)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.upsil"
            },
            "2": {
              "name": "entity.name.function.upsil"
            }
          }
        },
        {
          "match": "\\b(class|model)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.upsil"
            },
            "2": {
              "name": "entity.name.type.class.upsil"
            }
          }
        },
        {
          "match": "\\b(llm|vector_store)(?=\\s+[\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.resource.upsil"
            }
          }
        },
        {
          "match": "\\b(import)\\s+(py)(?=\\s*\")",
          "captures": {
            "1": {
              "name": "keyword.control.import.upsil"
            },
            "2": {
              "name": "keyword.other.py.upsil"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.upsil",
          "match": "\\b(if|else|while|for|return|break|continue)\\b"
        },
        {
          "name": "storage.type.upsil",
          "match": "\\b(fun|val|var|class)\\b"
        },
        {
          "name": "keyword.control.import.upsil",
          "match": "\\b(import|as)\\b"
        },
        {
          "name": "keyword.operator.word.upsil",
          "match": "\\b(and|or|not|in)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.upsil",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.upsil",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.language.self.upsil",
          "match": "\\b(self|super)\\b"
        }
      ]
    },
    "prompt": {
      "patterns": [
        {
          "name": "keyword.operator.prompt.upsil",
          "match": "=>"
        },
        {
          "match": "(->)\\s*(json)\\b",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.upsil"
            },
            "2": {
              "name": "support.type.json.upsil"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.upsil",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.upsil",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.comparison.upsil",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.upsil",
          "match": "[-+*/%]?="
        },
        {
          "name": "keyword.operator.arithmetic.upsil",
          "match": "\\*\\*|[-+*/%@]"
        }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.upsil",
      "match": "\\b(print|input|str|int|float|bool|len|range|list|dict|set|tuple|min|max|sum|abs|round|sorted|reversed|enumerate|zip|map|filter|any|all|chr|ord|format|isinstance|divmod|pow|iter|next|hash|div|error)\\b(?=\\s*\\()"
    },
    "calls": {
      "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.upsil"
        }
      }
    }
  }
}
