{
  "name": "upsil-lang",
  "displayName": "UpsiL",
  "description": "Syntax highlighting for UpsiL (.upl), a small language for AI scripts that compiles to Python",
  "version": "1.2.0",
  "publisher": "svoya-os",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/svoya-os/upsil"
  },
  "homepage": "https://github.com/svoya-os/upsil",
  "bugs": {
    "url": "https://github.com/svoya-os/upsil/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "keywords": [
    "upsil",
    "upl",
    "llm",
    "rag"
  ],
  "icon": "upsil-logo-v3.png",
  "contributes": {
    "iconThemes": [
      {
        "id": "upsil-icon-theme",
        "label": "UpsiL File Icons",
        "path": "./upsil-icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "upsil",
        "aliases": [
          "UpsiL",
          "upsil"
        ],
        "extensions": [
          ".upl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./upsil-logo-v3.png",
          "dark": "./upsil-logo-v3.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "upsil",
        "scopeName": "source.upsil",
        "path": "./syntaxes/upsil.tmLanguage.json"
      }
    ]
  }
}
