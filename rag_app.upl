import cortex.rag
import cortex.llm

fun main() {
    print("=== Cortex RAG AI App ===")
    
    // 1. Initialize our native LLM and Vector Store
    llm my_model = LLM(provider="cortex-native", model="Noesis-v1")
    vector_store db = VectorStore(dim=768)
    
    // 2. Add knowledge
    db.add("The EWSCS 2026 conference features courses on metric program equivalence and concurrent processes.")
    db.add("Cortex is a new programming language natively designed for neural networks and AI.")
    
    // 3. Search and Generate
    val query = "What is Cortex?"
    val context = db.search(query)
    
    // 4. Native Prompt Operator
    val answer = [my_model] => "Answer the query: {query} based on this context: {context}"
    
    print("\n[AI Output]:")
    print(answer)
}

main()
