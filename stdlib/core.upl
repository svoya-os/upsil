// UpsiL Standard Library: Core
// Memory management, garbage collection controls, and basic pointers

class Pointer {
    var addr: int
}

fun malloc_safe(size: int) -> int {
    val ptr = malloc(size)
    if (ptr == 0) {
        print("Panic: Out of Memory\n")
        // abort()
    }
    return ptr
}

fun free_safe(ptr: int) -> int {
    return free(ptr)
}

fun gc_collect() -> int {
    print("[GC] Triggering manual garbage collection...\n")
    return 1
}
