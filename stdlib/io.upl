// UpsiL Standard Library: Input/Output
// Provides high-level abstractions over LLVM File I/O mappings.

class File {
    var ptr: int
    var mode: int
}

fun open_file(path: int, mode: int) -> int {
    return fopen(path, mode)
}

fun read_file(file_ptr: int) -> int {
    // LLVM implementation for fread will be added here
    return 0
}

fun write_file(file_ptr: int, data: int) -> int {
    return fprintf(file_ptr, data)
}

fun close_file(file_ptr: int) -> int {
    return fclose(file_ptr)
}
