import ui
import llm

fun main() {
    var window = ui.Window("UpsiL NeuroChat 1.0", 600, 700)
    var ai = llm.Model("upsil-gpt-mini")
    
    fun on_message(msg: string) {
        var reply = ai.generate(msg)
        window.add_message("🤖 AI: " + reply)
    }
    
    window.on_submit(on_message)
    window.show()
}

main()
