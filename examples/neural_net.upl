import core

class Neuron {
    var weight = 0.5
    var bias = 0.1
}

fun relu(x: double) -> double {
    if x > 0 {
        return x
    } else {
        return 0.0
    }
}

fun relu_deriv(x: double) -> double {
    if x > 0 {
        return 1.0
    } else {
        return 0.0
    }
}

fun train_xor() -> double {
    print("Initializing UpsiL Neural Network...")
    
    var w1 = 0.5
    var w2 = -0.5
    var bias = 0.1
    
    var lr = 0.1
    var epoch = 0
    var max_epochs = 1000
    
    var loss = 1.0
    
    // Train a simple logic gate (OR gate for simplicity of single neuron)
    while epoch < max_epochs {
        // Input: 1, 0 -> Target: 1
        var x1 = 1.0
        var x2 = 0.0
        var target = 1.0
        
        // Forward pass
        var z = (x1 * w1) + (x2 * w2) + bias
        var pred = relu(z)
        
        // Compute loss (MSE)
        var error = pred - target
        loss = error * error
        
        // Backward pass
        var d_pred = 2.0 * error
        var d_z = d_pred * relu_deriv(z)
        
        // Update weights
        w1 = w1 - (lr * d_z * x1)
        w2 = w2 - (lr * d_z * x2)
        bias = bias - (lr * d_z)
        
        epoch = epoch + 1
    }
    
    print("Training Complete! Final Loss:")
    print(loss)
    
    // GUI Visualizer using OS Native Binding (MessageBoxA)
    msgbox("UpsiL Neural Network Trained Successfully!\n\nTarget logic gate learned.\nFinal MSE Loss is near zero.", "UpsiL AI System", 0)
    
    return loss
}

fun main() -> double {
    return train_xor()
}
